# =============================================================================
# CURRENT LEGACY VARIABLES STILL REQUIRED BY THE APP TODAY
# =============================================================================

# Public application origin used by fetch calls, metadata, payment callbacks, and asset URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Clerk is still the active auth provider until workstreams 03 and 09 complete.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=replace-with-clerk-publishable-key
CLERK_SECRET_KEY=replace-with-clerk-secret-key
CLERK_WEBHOOK_SIGNING_SECRET=replace-with-clerk-webhook-signing-secret
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_IN_FORCE_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FORCE_REDIRECT_URL=/dashboard

# Supabase is still the active database/storage backend until workstreams 05, 07, and 09 complete.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key

# SwitchApp is still used by the current checkout flow.
NEXT_PUBLIC_SW_PUBLIC_KEY=replace-with-switchapp-public-key

# =============================================================================
# TRANSITION VARIABLES
# =============================================================================

# First bootstrap identity for the future in-house auth and role system.
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_NAME=Platform Admin

# =============================================================================
# TARGET-STACK VARIABLES
# =============================================================================

# Auth.js + direct Google sign-in
AUTH_SECRET=replace-with-auth-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=false
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# MySQL
DATABASE_URL=mysql://app_user:app_password@127.0.0.1:3306/morris

# S3 or Cloudflare R2-compatible object storage
STORAGE_PROVIDER=s3
S3_BUCKET=replace-with-bucket-name
S3_REGION=replace-with-region
S3_ENDPOINT=https://replace-with-s3-or-r2-endpoint
S3_ACCESS_KEY_ID=replace-with-storage-access-key-id
S3_SECRET_ACCESS_KEY=replace-with-storage-secret-access-key
S3_PUBLIC_BASE_URL=https://cdn.example.com
