# =============================================================================
# APPLICATION (post–workstream 09)
# =============================================================================

# Public application origin used by fetch calls, metadata, and asset URLs.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Optional HTTPS origin used only for Switch (callback_url, live_webhook_url, logo_url).
# For local dev, run `ngrok http 3000` and set this to the forwarding URL (no trailing slash).
# If unset, Switch URLs use NEXT_PUBLIC_BASE_URL (localhost will not receive webhooks from Switch).
# If webhooks never arrive, set the same HTTPS URL + path `/api/webhooks/switchapp` in the Switch
# developer dashboard (they document dashboard webhooks alongside per-transaction URLs).
NEXT_PUBLIC_PAYMENTS_PUBLIC_ORIGIN=

# SwitchApp inline checkout — must be your PUBLIC key (pk_test_… / pk_live_…), not sk_…
# See https://docs.switchappgo.com/quick-start
NEXT_PUBLIC_SW_PUBLIC_KEY=pk_test_replace_with_key_from_switch_dashboard

# SwitchApp secret key (sk_test_… / sk_live_…) — server only. Used to call verify after checkout
# and must never be prefixed with NEXT_PUBLIC_. https://docs.switchappgo.com/payments/transactions/verify-transaction
SWITCHAPP_SECRET_KEY=

# First bootstrap super admin (see prisma/seed.ts)
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_NAME=Platform Admin

# Auth.js + Google OAuth
AUTH_SECRET=replace-with-auth-secret
AUTH_URL=http://localhost:3000
AUTH_TRUST_HOST=false
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# MySQL (Prisma)
DATABASE_URL=mysql://root:adminPassword@127.0.0.1:3306/morris

# Uploads (avatars, cases, generic images) are written under public/uploads/
# and served at /uploads/... — no object-storage env vars required.

# =============================================================================
# OFFLINE MIGRATION CLI ONLY (npm run migration:export)
# =============================================================================
# NEXT_PUBLIC_SUPABASE_URL=https://your-legacy-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
# LEGACY_SUPABASE_URL=
# LEGACY_SUPABASE_SERVICE_ROLE_KEY=
