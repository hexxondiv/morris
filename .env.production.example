# Canonical public origin (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://morris.example.com

# Optional HTTPS override for Switch callbacks/webhooks.
# Leave empty to reuse NEXT_PUBLIC_BASE_URL.
NEXT_PUBLIC_PAYMENTS_PUBLIC_ORIGIN=

# SwitchApp keys
NEXT_PUBLIC_SW_PUBLIC_KEY=pk_live_replace_with_switch_public_key
SWITCHAPP_SECRET_KEY=sk_live_replace_with_switch_secret_key

# Auth.js + Google OAuth
AUTH_SECRET=replace-with-long-random-secret
AUTH_URL=https://morris.example.com
AUTH_TRUST_HOST=true
AUTH_GOOGLE_ID=replace-with-google-oauth-client-id
AUTH_GOOGLE_SECRET=replace-with-google-oauth-client-secret

# Bootstrap super admin
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_NAME=Platform Admin

# MySQL (Prisma)
DATABASE_URL=mysql://morris_user:replace-password@127.0.0.1:3306/morris
